rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- User Profile ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'showWishlist'])
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'photoURL']) &&
             data.displayName is string && data.displayName.size() <= 50 &&
             data.photoURL is string && data.photoURL.size() <= 1000 &&
             (!data.keys().contains('bio') || (data.bio is string && data.bio.size() <= 500)) &&
             (!data.keys().contains('showWishlist') || data.showWishlist is bool);
    }

    // --- Posts ---
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidPost(incoming());
      allow update: if false; // Posts are immutable for now, or add specific actions
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    function isValidPost(data) {
      return data.userId == request.auth.uid &&
             data.drinkName is string && data.drinkName.size() <= 100 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             data.category in ['Coffee', 'Wine', 'Beer', 'Cocktail', 'Other'] &&
             (!data.keys().contains('locationName') || (data.locationName is string && data.locationName.size() <= 100)) &&
             (!data.keys().contains('city') || (data.city is string && data.city.size() <= 100)) &&
             (!data.keys().contains('caption') || (data.caption is string && data.caption.size() <= 1000)) &&
             data.rating is int && data.rating >= 0 && data.rating <= 1;
    }

    // --- Follows ---
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().followerId) && incoming().followerId != incoming().followedId;
      allow delete: if isSignedIn() && isOwner(existing().followerId);
    }
  }
}
